# Copy to .env and fill in. Never commit .env.
#
# The game has no API keys. All artist data is fetched at run time from the
# public Wikidata Query Service, which needs no authentication and sends
# `Access-Control-Allow-Origin: *`, so the browser can query it directly.
#
# CONTACT_EMAIL is only used to identify you if you ever run a Node script
# against WDQS: that service answers 403 to clients it cannot identify, and
# browsers cannot set User-Agent themselves. Nothing in the app reads these.
CONTACT_EMAIL=you@example.com
USER_AGENT="AmandleBuilder/0.1 (${CONTACT_EMAIL})"